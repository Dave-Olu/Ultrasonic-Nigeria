# Generate a random value with at least 32 bytes for production.
ADMIN_SESSION_SECRET=

# Neon PostgreSQL connection string for persistent admin auth on Vercel.
DATABASE_URL=

# Set the public origin used to build sign-in links.
APP_BASE_URL=http://localhost:3001

# Resend API credentials; the sender address must be verified with Resend.
RESEND_API_KEY=
ADMIN_AUTH_FROM_EMAIL=